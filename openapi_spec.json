{
  "openapi": "3.1.0",
  "info": {
    "title": "Crispr Prime Editing Pegdna Agent API",
    "description": "Deterministic rule-based evaluator for repository-defined prime-editing metrics. This API does not design pegRNA sequences or perform off-target analysis.",
    "version": "3.0.0-ENTERPRISE",
    "contact": {
      "name": "Dr. Abu Suraih Sakhri",
      "url": "https://github.com/abusuraihsakhri"
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Service health check",
        "responses": {
          "200": {
            "description": "Service status"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Return in-memory process counters",
        "responses": {
          "200": {
            "description": "JSON process counters"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Evaluate a task with the audited multi-worker workflow",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number",
                    "default": 0.0
                  },
                  "status_descriptor": {
                    "type": "string",
                    "default": "NOMINAL"
                  },
                  "is_critical_flag": {
                    "type": "boolean",
                    "default": false
                  },
                  "attributes": {
                    "type": "object",
                    "additionalProperties": true
                  }
                },
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Consensus dossier with an HMAC-linked audit hash"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Return the deterministic mock supervisory response",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Mock supervisory response"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Return in-memory audit metadata and integrity status",
        "responses": {
          "200": {
            "description": "Audit metadata and HMAC chain verification result"
          }
        }
      }
    }
  }
}
